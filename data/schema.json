{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Research Library catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "description",
      "category_en",
      "category_tr",
      "rights_note",
      "download_policy",
      "url",
      "category",
      "formats",
      "search_modes",
      "keywords",
      "example_queries",
      "access",
      "reuse_class",
      "commercial_use",
      "license_url",
      "verification",
      "agent_access"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "category_en": {
        "type": "string",
        "minLength": 1
      },
      "category_tr": {
        "type": "string",
        "minLength": 1
      },
      "rights_note": {
        "type": "string",
        "minLength": 1
      },
      "download_policy": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "pattern": "^https://"
      },
      "category": {
        "enum": [
          "scene",
          "reaction",
          "english",
          "stock-free",
          "stock-paid",
          "history",
          "history-tr",
          "science",
          "medical",
          "animation",
          "maps",
          "data",
          "museum",
          "3d",
          "nature",
          "sound",
          "research",
          "verify",
          "news",
          "law",
          "tech",
          "learning"
        ]
      },
      "formats": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "search_modes": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "keywords": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "example_queries": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "access": {
        "enum": [
          "free",
          "freemium",
          "paid",
          "mixed",
          "unknown"
        ]
      },
      "reuse_class": {
        "enum": [
          "conditional",
          "item",
          "paid_license",
          "restricted",
          "discovery",
          "tool"
        ]
      },
      "commercial_use": {
        "enum": [
          "conditional",
          "item_required",
          "license_required",
          "restricted",
          "not_established",
          "output_required"
        ]
      },
      "license_url": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^https://"
          },
          {
            "type": "null"
          }
        ]
      },
      "verification": {
        "type": "object",
        "required": [
          "status",
          "checked_on",
          "evidence_url",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "provider_evidence",
              "candidate_review_required"
            ]
          },
          "checked_on": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "agent_access": {
        "type": "object",
        "required": [
          "method",
          "documentation_url",
          "automation_note"
        ],
        "additionalProperties": false,
        "properties": {
          "method": {
            "enum": [
              "documented_interface",
              "website"
            ]
          },
          "documentation_url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "automation_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
